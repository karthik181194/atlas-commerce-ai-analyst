{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "migration:up": "node-pg-migrate up --migrations-dir migrations",
    "generator:run": "ts-node src/generator/run-generator.ts",
    "generator:verify": "jest --runInBand generator/generator-runner.spec.ts",
    "generator:reference-data": "ts-node src/generator/run-reference-data.ts",
    "generator:reference-data:verify": "jest --runInBand generator/reference-data/reference-data.spec.ts",
    "generator:customers": "ts-node src/generator/run-customers.ts",
    "generator:customers:verify": "jest --runInBand generator/customers/customer-generator.spec.ts",
    "generator:campaigns": "ts-node src/generator/run-campaigns.ts",
    "generator:campaigns:verify": "jest --runInBand generator/campaigns/campaign-generator.spec.ts",
    "generator:orders": "ts-node src/generator/run-orders.ts",
    "generator:orders:verify": "jest --runInBand generator/orders/order-generator.spec.ts",
    "generator:returns": "ts-node src/generator/run-returns.ts",
    "generator:returns:verify": "jest --runInBand generator/returns/return-generator.spec.ts",
    "generator:inventory": "ts-node src/generator/run-inventory.ts",
    "generator:inventory:verify": "jest --runInBand generator/inventory/inventory-generator.spec.ts",
    "generator:validation": "ts-node src/generator/validation/run-validation.ts",
    "generator:validation:verify": "jest --runInBand generator/validation/hidden-event-validation.spec.ts",
    "generator:db": "ts-node src/generator/run-dataset.ts",
    "generator:db:prod": "ts-node src/generator/run-dataset.prod.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
